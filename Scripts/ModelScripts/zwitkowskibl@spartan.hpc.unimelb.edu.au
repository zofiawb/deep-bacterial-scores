#!/bin/bash
# SLURM script for train_cnn_rinalmo_v2.py
# ── DIAGNOSTIC RUN ──
# SUBSET_FRAC=0.01, EPOCHS=1 — completes in ~10 min
# Read the "projection" line in the output to set walltime for real runs,
# then change SUBSET_FRAC=0.10, EPOCHS=20 in the Python script.

#SBATCH --partition=gpu-a100
#SBATCH --nodes=1
#SBATCH --job-name="rinalmo_diagnostic"
#SBATCH --account="punim1021"

#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8        # feeds 4 DataLoader workers with headroom

#SBATCH --gres=gpu:1             # 1 GPU; code only uses cuda:0

#SBATCH --mem=40G                # 13M rows in RAM + micro model + batch=256

#SBATCH --mail-user=zwitkowskibl@student.unimelb.edu.au
#SBATCH --mail-type=FAIL,BEGIN,END

#SBATCH --time=0-0:30:00         # 30 min is plenty for 1 epoch at 1% subset

if [ "x$SLURM_JOB_ID" == "x" ]; then
   echo "You need to submit your job to the queuing system with sbatch"
   exit 1
fi

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}

module purge
module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate /home/zwitkowskibl/.conda/envs/rinalmo

echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo "Start: $(date)"
echo "Working dir: $(pwd)"
nvidia-smi

python3 train_cnn_rinalmo_v3.py

echo "End: $(date)"

##DO NOT ADD/EDIT BEYOND THIS LINE##
my-job-stats -a -n -s
